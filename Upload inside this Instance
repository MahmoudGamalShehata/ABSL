import ABSL;
import AP.Common.GDT;
import AP.PlatinumEngineering;

if(!this.LIAttachement.IsSet()) { return; }
if(!this.LIAttachement.AttachmentExistsIndicator) {return; }

var CSVColumnNames : XPEStringTab;
CSVColumnNames.XPEString.Add("Inventory ID");
CSVColumnNames.XPEString.Add("Location");
CSVColumnNames.XPEString.Add("Sub Location");
CSVColumnNames.XPEString.Add("Site");

var docList = this.LIAttachement.DocumentList;
if(docList.Count() == 0) { return; }
var doc = docList.GetFirst();
var docContent = doc.FileContent.BinaryObject.content.ToString();
var csv = CSV.ParseQuoted(docContent, "," , CSVColumnNames);

var row = 1;
var LICreate: elementsof InventoryComparison.LastInventories;

var LI;

if(csv.CSVStringTab.Count() > 0)
{
	foreach(var csvRow in csv.CSVStringTab)
	{
		var col = 1;
		if(csvRow.XPEString.Count() > 0)
		{
			foreach(var csvColumn in csvRow.XPEString)
			{
				if(csvColumn.IsInitial()) { col = col + 1; continue; }
				// Fill Last Inventories.
				else if(col == 1) { LICreate.InventoryIDL = csvColumn; }
				else if(col == 2) { LICreate.LocationL = csvColumn; }
				else if(col == 3) { LICreate.SubLocationL = csvColumn; }
				else if(col == 4) { LICreate.SiteL = csvColumn; }
		 
				col = col + 1;
			}
			LI = this.ToParent.LastInventories.Create(LICreate);
			LICreate.Clear();
			row = row + 1;
		}
	}
}

this.Delete();
